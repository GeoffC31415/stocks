# Database URL (defaults to sqlite+aiosqlite:///./portfolio.db)
PORTFOLIO_DATABASE_URL=sqlite+aiosqlite:///./portfolio.db

# Trading 212 read-only API credentials (never grant order permissions)
PORTFOLIO_TRADING212_API_KEY=
PORTFOLIO_TRADING212_API_SECRET=
# Optional display/account scope name
PORTFOLIO_TRADING212_ACCOUNT_NAME=Trading 212

# Public-site button: disabled until the narrow polkit policy is installed and tested.
# This flag belongs in production.env; bank credentials do NOT.
PORTFOLIO_SYNC_SERVICE_TRIGGER_ENABLED=false

# Barclays sync-worker-only settings (production: /etc/stocks/brokers.env).
# Do not enable until one supervised guarded login and copied-DB rehearsal pass.
PORTFOLIO_BARCLAYS_AUTOMATION_ENABLED=false
PORTFOLIO_BARCLAYS_SURNAME=
PORTFOLIO_BARCLAYS_MEMBERSHIP_NUMBER=
PORTFOLIO_BARCLAYS_PASSCODE=
PORTFOLIO_BARCLAYS_MEMORABLE_WORD=
# Exact qualified account label from the validated workbook, entered locally.
PORTFOLIO_BARCLAYS_EXPECTED_ACCOUNT=
