// Separate operator grant; install only after explicit approval, root:root 0644.
// Does not replace the stocks web identity's existing start-only policy.
polkit.addRule(function(action, subject) {
    if (subject.user === "geoff" &&
        action.id === "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") === "stocks-sync.service" &&
        action.lookup("verb") === "start") {
        return polkit.Result.YES;
    }
});
