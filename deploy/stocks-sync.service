[Unit]
Description=Stocks read-only broker sync (HL downloads, inbox import, Trading 212)
Wants=network-online.target
After=network-online.target stocks.service

[Service]
Type=oneshot
User=stocks-sync
Group=stocks-sync
SupplementaryGroups=stocks-data
WorkingDirectory=/opt/stocks/current
EnvironmentFile=/etc/stocks/brokers.env
Environment=PYTHONPATH=/opt/stocks/current/backend
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=PORTFOLIO_SYNC_INBOX=/var/lib/stocks-sync/inbox
Environment=PORTFOLIO_BROWSER_PROFILE=/var/lib/stocks-sync/browser
Environment=PLAYWRIGHT_BROWSERS_PATH=/opt/stocks/playwright
Environment=PLAYWRIGHT_HOST_PLATFORM_OVERRIDE=ubuntu24.04-x64
Environment=HOME=/var/lib/stocks-sync
Environment=PORTFOLIO_SYNC_STATUS_DIR=/var/lib/stocks-status
ExecStart=/opt/stocks/current/.venv/bin/python -m app.sync_cli
TimeoutStartSec=15min
UMask=0007
StateDirectory=stocks-sync
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ReadWritePaths=/var/lib/stocks-data
ReadWritePaths=/var/lib/stocks-status
InaccessiblePaths=-/var/lib/stocks
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
MemoryHigh=1536M
MemoryMax=2G
TasksMax=256
