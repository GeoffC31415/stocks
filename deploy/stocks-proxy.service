[Unit]
Description=Stocks HTTPS proxy (solarpi.hopto.org:5000; ACME on 80)
Wants=network-online.target
Requires=stocks.service
After=network-online.target stocks.service
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=simple
DynamicUser=true
StateDirectory=stocks-proxy
StateDirectoryMode=0700
WorkingDirectory=/var/lib/stocks-proxy
EnvironmentFile=/etc/stocks/caddy.env
Environment=XDG_DATA_HOME=/var/lib/stocks-proxy/data
Environment=XDG_CONFIG_HOME=/var/lib/stocks-proxy/config
ExecStart=/opt/stocks/current/bin/caddy run --config /opt/stocks/current/deploy/Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=256M
TasksMax=64
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
