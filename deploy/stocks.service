[Unit]
Description=Private portfolio tracker (loopback backend)
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=simple
User=stocks
Group=stocks
WorkingDirectory=/opt/stocks/current
EnvironmentFile=/etc/stocks/production.env
Environment=PYTHONPATH=/opt/stocks/current/backend
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
# Read-only view of the scheduled sync's last result (stocks-sync.service writes it).
Environment=PORTFOLIO_SYNC_INBOX=/var/lib/stocks/inbox
ExecStart=/opt/stocks/current/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1 --proxy-headers --forwarded-allow-ips 127.0.0.1 --limit-concurrency 16 --timeout-keep-alive 5 --timeout-graceful-shutdown 30 --no-access-log --no-server-header
Restart=on-failure
RestartSec=5
TimeoutStopSec=40
UMask=0077
StateDirectory=stocks
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryHigh=768M
MemoryMax=1G
TasksMax=64

[Install]
WantedBy=multi-user.target
